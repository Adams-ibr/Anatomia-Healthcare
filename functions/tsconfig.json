{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitAny": false,
    "outDir": "lib",
    "sourceMap": true,
    "strict": false,
    "target": "ES2020",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": false,
    "resolveJsonModule": true,
    "lib": ["ES2020"],
    "noEmitOnError": false,
    "declaration": false
  },
  "compileOnSave": true,
  "include": ["src", "../server/**/*", "../shared/**/*"],
  "exclude": ["node_modules"]
}
