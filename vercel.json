{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "serverlessFunctionRegion": "iad1",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/index.cjs"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/**": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}