NODE_ENV=production
PORT=5000

# Firebase Admin (Server)
FIREBASE_PROJECT_ID=anatomia-healthcare
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@anatomia-healthcare.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=your-private-key-here
FIREBASE_STORAGE_BUCKET=anatomia-healthcare.firebasestorage.app

# Session Management
SESSION_SECRET=your-secure-random-string-32-chars-minimum

# Paystack (optional)
PAYSTACK_SECRET_KEY=your-paystack-key-here
